{
  "name": "meepo",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-worker Execution Engine for Project-isolated Orchestration",
  "scripts": {
    "prepare": "simple-git-hooks",
    "check": "moon run :lint :typecheck :test",
    "build": "moon run :build",
    "format": "moon run :format",
    "lint": "moon run :lint",
    "typecheck": "moon run :typecheck",
    "test": "moon run :test"
  },
  "devDependencies": {
    "@moonrepo/cli": "^2.2.0",
    "eslint": "^9.31.0",
    "git-conventional-commits": "^2.8.0",
    "prettier": "^3.5.3",
    "simple-git-hooks": "^2.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.1.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm moon run :lint :typecheck --affected --status=staged",
    "commit-msg": "pnpm git-conventional-commits commit-msg-hook -c .commitlintrc.yaml \"$1\""
  },
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  }
}
