{
  "name": "@meepo/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client SDK for interacting with Meepo control plane and worker network",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@meepo/core": "workspace:*",
    "@meepo/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
