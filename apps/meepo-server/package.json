{
  "name": "meepo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Central control plane for Meepo: Feishu gateway, space/session manager, dispatcher, and ticket queue",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.1",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@meepo/core": "workspace:*",
    "@meepo/protocol": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "fastify": "^5.12.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
