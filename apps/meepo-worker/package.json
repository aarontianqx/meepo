{
  "name": "meepo-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Distributed execution runner for Meepo: git worktree management, Pi runtime execution",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@meepo/core": "workspace:*",
    "@meepo/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.22.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
